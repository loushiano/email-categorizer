# ===========================================
# Database Configuration (MySQL)
# ===========================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=email_agent

# ===========================================
# Application Environment
# ===========================================
NODE_ENV=development
# Options: development, production, test

# ===========================================
# Google OAuth & Gmail API Configuration
# ===========================================
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT=http://localhost:8085/auth/google/verify

# ===========================================
# Google Cloud Pub/Sub Configuration
# ===========================================
# Used for Gmail push notifications
# Create topic/subscription at: https://console.cloud.google.com/cloudpubsub
GOOGLE_QUEUE_TOPIC=projects/your-project-id/topics/gmail-msgs
GOOGLE_QUEUE_SUB=projects/your-project-id/subscriptions/gmail-msgs-sub

# Path to Google Cloud service account credentials JSON file
# Download from: https://console.cloud.google.com/iam-admin/serviceaccounts
GOOGLE_APPLICATION_CREDENTIALS=./google_credentials.json

# ===========================================
# Anthropic API Configuration
# ===========================================
# Get your API key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-your_anthropic_api_key

# ===========================================
# Security
# ===========================================
# Used to encrypt sensitive data (e.g., OAuth tokens)
# Generate a secure random 32-character string
ENCRYPTION_KEY=your_32_character_encryption_key

# ===========================================
# JWT Configuration (Optional - if using JWT auth)
# ===========================================
# JWT_SECRET=your_jwt_secret_key

# ===========================================
# RabbitMQ Configuration (Optional - if using RabbitMQ)
# ===========================================
# RABBITMQ_URL=amqp://localhost:5672
# RABBITMQ_QUEUE=email_processing

# ===========================================
# Redis Configuration (Optional - if using Redis)
# ===========================================
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
